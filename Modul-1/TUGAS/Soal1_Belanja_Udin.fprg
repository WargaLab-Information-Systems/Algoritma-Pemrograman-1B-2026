<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Soal1_Belanja_Udin"/>
        <attribute name="authors" value="Mahasiswa"/>
        <attribute name="about" value="Flowchart belanja Udin: input jumlah barang, harga sesuai soal"/>
        <attribute name="saved" value="2026-11-05 10:00:00 AM"/>
        <attribute name="created" value="MjAyNi0xMS0wNTsxMDowMDowMCBBTTsw"/>
        <attribute name="edited" value="MjAyNi0xMS0wNTsxMDowMDowMCBBTTsw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="jmlBuku, jmlPulpen, jmlFlashdisk" type="Integer" array="False" size=""/>
            <declare name="hargaBuku, hargaPulpen, hargaFlashdisk, persenDiskon, persenPPN, uangTunai" type="Real" array="False" size=""/>
            <declare name="totalBuku, totalPulpen, totalFlashdisk, totalSebelumDiskon" type="Real" array="False" size=""/>
            <declare name="diskon, setelahDiskon, pajak, totalBayar, kembalian" type="Real" array="False" size=""/>
            <assign variable="hargaBuku" expression="25000"/>
            <assign variable="hargaPulpen" expression="8000"/>
            <assign variable="hargaFlashdisk" expression="75000"/>
            <assign variable="persenDiskon" expression="10"/>
            <assign variable="persenPPN" expression="11"/>
            <assign variable="uangTunai" expression="200000"/>
            <output expression="&quot;Jumlah buku: &quot;" newline="False"/>
            <input variable="jmlBuku"/>
            <output expression="&quot;Jumlah pulpen: &quot;" newline="False"/>
            <input variable="jmlPulpen"/>
            <output expression="&quot;Jumlah flashdisk: &quot;" newline="False"/>
            <input variable="jmlFlashdisk"/>
            <assign variable="totalBuku" expression="jmlBuku * hargaBuku"/>
            <assign variable="totalPulpen" expression="jmlPulpen * hargaPulpen"/>
            <assign variable="totalFlashdisk" expression="jmlFlashdisk * hargaFlashdisk"/>
            <assign variable="totalSebelumDiskon" expression="totalBuku + totalPulpen + totalFlashdisk"/>
            <assign variable="diskon" expression="totalSebelumDiskon * persenDiskon / 100"/>
            <assign variable="setelahDiskon" expression="totalSebelumDiskon - diskon"/>
            <assign variable="pajak" expression="setelahDiskon * persenPPN / 100"/>
            <assign variable="totalBayar" expression="setelahDiskon + pajak"/>
            <assign variable="kembalian" expression="uangTunai - totalBayar"/>
            <output expression="&quot;a) Total harga buku: &quot; &amp; totalBuku" newline="True"/>
            <output expression="&quot;b) Total harga pulpen: &quot; &amp; totalPulpen" newline="True"/>
            <output expression="&quot;c) Total harga flashdisk: &quot; &amp; totalFlashdisk" newline="True"/>
            <output expression="&quot;d) Total sebelum diskon: &quot; &amp; totalSebelumDiskon" newline="True"/>
            <output expression="&quot;e) Besar diskon: &quot; &amp; diskon" newline="True"/>
            <output expression="&quot;f) Harga setelah diskon: &quot; &amp; setelahDiskon" newline="True"/>
            <output expression="&quot;g) Besar pajak: &quot; &amp; pajak" newline="True"/>
            <output expression="&quot;h) Total pembayaran: &quot; &amp; totalBayar" newline="True"/>
            <output expression="&quot;i) Uang kembalian: &quot; &amp; kembalian" newline="True"/>
        </body>
    </function>
</flowgorithm>
