<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Soal1_Brankas"/>
        <attribute name="authors" value="Mahasiswa"/>
        <attribute name="about" value="Tugas Praktikum Modul II - Soal 1"/>
        <attribute name="saved" value="2026-10-05 10:17:35 PM"/>
        <attribute name="created" value="TWFoYXNpc3dhO0xBUFRPUDsyMDI2LTEwLTA1OzEwOjAwOjAwIEFNOzEwMDA="/>
        <attribute name="edited" value="TWFoYXNpc3dhO0xBUFRPUDsyMDI2LTEwLTA1OzEwOjAwOjAwIEFNOzEwMDA="/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUVOVTg5M1M7MjAyNi0xMC0wNTsxMDoxNzozNSBQTTsyOzI4NjM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, digit1, digit2, digit3, pelacakawal, pelacak1, pelacakakhir" type="Integer" array="False" size=""/>
            <declare name="status" type="String" array="False" size=""/>
            <declare name="siklus" type="String" array="False" size=""/>
            <output expression="&quot;Masukkan kode rahasia 3 digit: &quot;" newline="True"/>
            <input variable="kode"/>
            <assign variable="digit1" expression="Int(kode / 100)"/>
            <assign variable="digit2" expression="Int(kode / 10) % 10"/>
            <assign variable="digit3" expression="kode % 10"/>
            <assign variable="pelacakawal" expression="digit1 * digit3"/>
            <if expression="digit2 % 2 == 1">
                <then>
                    <assign variable="pelacak1" expression="pelacakawal + 25"/>
                </then>
                <else>
                    <assign variable="pelacak1" expression="pelacakawal - digit2"/>
                </else>
            </if>
            <if expression="pelacak1 % 3 == 0">
                <then>
                    <assign variable="pelacakakhir" expression="Int(pelacak1 / 3)"/>
                </then>
                <else>
                    <assign variable="pelacakakhir" expression="pelacak1 * 2"/>
                </else>
            </if>
            <if expression="pelacakakhir &gt; 50">
                <then>
                    <assign variable="status" expression="&quot;Password Kategori A&quot;"/>
                </then>
                <else>
                    <if expression="pelacakakhir &gt; 20">
                        <then>
                            <assign variable="status" expression="&quot;Password Kategori B&quot;"/>
                        </then>
                        <else>
                            <assign variable="status" expression="&quot;Password Ditolak&quot;"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="pelacakakhir % 2 == 0">
                <then>
                    <assign variable="siklus" expression="&quot;Siklus Genap&quot;"/>
                </then>
                <else>
                    <assign variable="siklus" expression="&quot;Siklus Ganjil&quot;"/>
                </else>
            </if>
            <output expression="&quot;Digit pertama: &quot; &amp; digit1" newline="True"/>
            <output expression="&quot;Digit kedua: &quot; &amp; digit2" newline="True"/>
            <output expression="&quot;Digit ketiga: &quot; &amp; digit3" newline="True"/>
            <output expression="&quot;Nilai pelacak awal: &quot; &amp; pelacakawal" newline="True"/>
            <output expression="&quot;Setelah perubahan tahap 1: &quot; &amp; pelacak1" newline="True"/>
            <output expression="&quot;Setelah perubahan tahap 2 (nilai akhir): &quot; &amp; pelacakakhir" newline="True"/>
            <output expression="&quot;Status: &quot; &amp; status" newline="True"/>
            <output expression="siklus" newline="True"/>
        </body>
    </function>
</flowgorithm>
